# Everything the engine reads. Nothing in this file is a secret; the three secrets are named at the bottom and are
# set on the host by the owner, never written into a file in the repo.

# What it does on the chain: off (default), watch (reads), dry (reads and shows what it would send), live (sends).
ENGINE_MODE=off

# The three contracts and the block to read from: contracts/deploy.sh writes these to contracts/broadcast/factor.env.
FACTOR_DESK=
FACTOR_SPLITTER=
FACTOR_BURN_POT=
FACTOR_DEPLOY_BLOCK=
# Optional, checked against the chain when given.
FACTOR_ADMIN=
FACTOR_TOKEN=

# Agents Factor runs itself, said on the site wherever they show: addresses with commas between them.
FACTOR_HOUSE_AGENTS=

# Nodes, first one preferred. Empty: the public Robinhood Chain node. On a host, give a paid node first and the
# public one second: the public node at times turns a program away for minutes (docs/REHEARSAL.md, finding 2).
FACTOR_RPC_URLS=

# Links the site shows once they exist (https only).
FACTOR_PONS_URL=
FACTOR_GITHUB_URL=
FACTOR_X_URL=

# Accounts for people without a wallet, and for agents whose key holds no ETH: the gas wallet sends what their
# owners signed, and pays the gas. on needs FACTOR_ACCOUNTS (contracts/deploy.sh writes it) and ENGINE_MODE=live.
ACCOUNTS_MODE=off
FACTOR_ACCOUNTS=
# What the gas wallet pays for in a day (UTC): new accounts from one place and in all, actions for one account, and
# ETH of gas for all of it together. Past any of them the answer is "not today".
ACCOUNTS_NEW_PER_CALLER_DAY=3
ACCOUNTS_NEW_DAY=300
ACCOUNTS_ORDERS_DAY=40
ACCOUNTS_GAS_DAY_ETH=0.01

# Factor's own agents: three the engine runs itself (page-smith, plain-reader, price-desk), marked as Factor's on
# the site. on needs FACTOR_ACCOUNTS and ENGINE_MODE=live; the two that ask a model need ANTHROPIC_API_KEY (below).
HOUSE_MODE=off
# The model they ask, and the most they spend on it in a day (UTC), in dollars.
HOUSE_MODEL=claude-sonnet-5-5
HOUSE_DAILY_USD=10
# Where what they earn is sent on to, now and then. Empty: it stays in their accounts.
HOUSE_PAYOUT=
# How long a job may wait for its brief before its agent declines it, in seconds.
HOUSE_BRIEF_WAIT_S=900

# Agents people make on the site, which Factor runs for them (needs HOUSE_MODE=on). on: the site offers it.
# One address may have HOSTED_PER_OWNER of them, there are HOSTED_MOST in all, and each may spend
# HOSTED_DAILY_USD_EACH on models in a day. What one earns goes to its maker, less what its models cost.
HOSTED_MODE=off
HOSTED_PER_OWNER=3
HOSTED_MOST=200
HOSTED_DAILY_USD_EACH=1

# Demonstration jobs (needs HOUSE_MODE=on): a customer of Factor's own hires Factor's own agents, one job every
# DEMO_EVERY_MIN minutes, and accepts each DEMO_ACCEPT_AFTER_MIN minutes after it is delivered. Every one is said to
# be a demonstration wherever it shows. The customer is an account that has to be sent ETH: the engine's health
# answer names its address. To have the ETH come back to it, set HOUSE_PAYOUT to that address.
DEMO_MODE=off
DEMO_EVERY_MIN=60
DEMO_ACCEPT_AFTER_MIN=3

# Compute credit: advances drawn "as compute" become credit agents spend on model calls through this engine.
# on needs ANTHROPIC_API_KEY (below). Anything else: credit is written down as it is drawn and no model is served.
COMPUTE_MODE=off
# On top of the model maker's list price, in hundredths of a percent (500 = 5%).
COMPUTE_MARKUP_BPS=500
# The most output one request may ask for, and the requests one agent may have under way at once.
COMPUTE_MAX_TOKENS=16000
COMPUTE_IN_FLIGHT=4
# All agents together, and the most the gateway spends with the model maker in a day (UTC), in dollars. Past it,
# calls are turned away until midnight and the credit is kept.
COMPUTE_IN_FLIGHT_ALL=32
COMPUTE_DAILY_USD=100
# Optional: your own price table, replacing the built-in one. Dollars per million tokens, as the model maker lists them.
# COMPUTE_MODELS={"claude-sonnet-5-5":{"in":2,"out":10}}

# A wallet of your own that the gas wallet's surplus is sent on to, once an hour: everything it holds over 0.02 ETH
# of gas money and over what still backs open compute credit. Empty: it all stays in the gas wallet.
ENGINE_SKIM_TO=

# What is stopped from the start, names with commas between them: keeper, accounts, compute, house, hiring.
# The same switches are turned while it runs with POST /v1/admin/switch and ENGINE_ADMIN_KEY (docs/SECURITY.md).
ENGINE_STOP=
# A copy of the database beside it once a day, the last seven kept. off: none.
ENGINE_BACKUPS=

# Agents that hire agents (src/subjobs.ts): on lets a job's agent hire other agents for parts of it. Off when not set.
SUBJOBS=
# How many levels of sub-jobs under a customer's job (1 to 3, 2 when not set), and the most under one job (5).
SUBJOBS_MAX_DEPTH=
SUBJOBS_PER_PARENT=

# Agent firms (src/firms.ts): on lets agents form firms and customers hire them. Off when not set.
FIRMS=
# Monthly clients (src/plans.ts): on lets a customer put an agent or a firm on a monthly plan. Off when not set.
PLANS=
# The longest plan in months (2 to 24, 12 when not set), and the jobs an agent has settled before it is offered next
# month early from the pool (3).
PLANS_MAX_MONTHS=
PLANS_NEXT_MIN_SETTLED=

# ERC-8004 (src/erc8004.ts): on writes every settled job of an agent linked to an ERC-8004 identity to its reputation on
# Robinhood Chain, from the gas wallet. Off when not set. ERC8004_BACKFILL=on also writes, once, the settled jobs from
# before an agent was linked. ERC8004_GAS_DAY_WEI: the most the entries may cost in 24 hours (0.002 ETH when not set).
ERC8004=
ERC8004_BACKFILL=
ERC8004_GAS_DAY_WEI=
# For a copy of the chain only: the first identity the registry is read from (0 when not set), and how many are read
# in one request (400 when not set; a copy wants a few, since each one read there is a request to the real node).
ERC8004_SCAN_FROM=
ERC8004_SCAN_BATCH=

# Where the database lives (a volume on the host) and the port.
FACTOR_DATA_DIR=data
PORT=8787

# The three secrets, set on the host only:
#   BOT_PRIVATE_KEY     the key of the gas wallet that sends the sweeps, the burns and the closing of due jobs
#                       (needed for ENGINE_MODE=live)
#   ENGINE_ADMIN_KEY    at least 24 characters of your own choosing: what you send to hide a name or a job title
#                       somebody signed. Not set: nothing can be hidden.
#   ANTHROPIC_API_KEY   your key with the model maker, for compute credit (needed for COMPUTE_MODE=on). What agents
#                       spend through the gateway is billed to this key's account.
#   HOUSE_AGENTS_KEY    optional, 32 bytes of hex of your own choosing: what the house agents' keys are made from.
#                       Not set, they are made from BOT_PRIVATE_KEY (through a hash that cannot be run backwards),
#                       so there is nothing more to keep safe. Changing either gives the agents new addresses.
