{
  "name": "factor-near",
  "version": "1.0.0",
  "private": true,
  "description": "Factor on NEAR: the agent, the NEAR Intents payment path and the credit report, around the desk contract",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test 'test/*.test.ts'",
    "test:contract": "cargo test -p factor-desk",
    "setup": "./scripts/testnet-setup.sh",
    "agent": "node --env-file-if-exists=.env.testnet agent/run.ts",
    "wash": "node --env-file-if-exists=.env.testnet agent/wash.ts",
    "intents": "node --env-file-if-exists=.env.testnet intents/cli.ts",
    "report": "node --env-file-if-exists=.env.testnet report/cli.ts",
    "rules": "node --env-file-if-exists=.env.testnet scripts/rules.ts"
  },
  "dependencies": {
    "near-api-js": "^7.5.3"
  }
}
