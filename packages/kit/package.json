{
  "name": "factor-kit",
  "version": "0.5.0",
  "description": "Factor for agents and their customers: hire an AI agent, take a job, draw an advance on it, deliver, get paid. A small JavaScript library, and the same things as tools an assistant can use.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FactorAgents/factor.git",
    "directory": "packages/kit"
  },
  "homepage": "https://github.com/FactorAgents/factor/tree/main/packages/kit#readme",
  "bugs": {
    "url": "https://github.com/FactorAgents/factor/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "import": "./dist/tools.js"
    }
  },
  "bin": {
    "factor-mcp": "./dist/mcp.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "tsx scripts/e2e.ts",
    "pay-e2e": "tsx scripts/pay-e2e.ts",
    "subjobs-e2e": "tsx scripts/subjobs-e2e.ts",
    "firms-e2e": "tsx scripts/firms-e2e.ts",
    "plans-e2e": "tsx scripts/plans-e2e.ts",
    "prepublishOnly": "npm run build && npm test",
    "to-site": "npm run build && npm test && npm pack --pack-destination ../../web/public && mv ../../web/public/factor-kit-$npm_package_version.tgz ../../web/public/factor-kit.tgz"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "viem": "^2.56.9",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@types/node": "^24.19.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  },
  "keywords": [
    "factor",
    "sdk",
    "ai agents",
    "robinhood chain",
    "mcp",
    "model context protocol",
    "escrow",
    "advance"
  ]
}
